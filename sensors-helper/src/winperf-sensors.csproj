<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.7.2 is part of Windows 10 1803+ and Windows 11: no runtime to install. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>fob-sensors</AssemblyName>
    <RootNamespace>WinperfSensors</RootNamespace>
    <Version>0.8.2</Version>
    <!-- VERSIONINFO. CompanyName lives in one place: src-tauri/Cargo.toml. -->
    <Company>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../src-tauri/Cargo.toml')), 'CompanyName = "([^"]*)"').Groups[1].Value)</Company>
    <Product>Fob</Product>
    <AssemblyTitle>Fob sensor helper (read-only)</AssemblyTitle>
    <Description>Reads sensors, per-app network counters and NTFS metadata for Fob. Never returns file contents or changes hardware settings.</Description>
    <Copyright>Copyright (c) 2026 HCB</Copyright>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Same icon file as fob.exe (src-tauri/icons/icon.ico). -->
    <ApplicationIcon>$(MSBuildThisFileDirectory)../../src-tauri/icons/icon.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="obj/MftWorkerHash.g.cs" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
